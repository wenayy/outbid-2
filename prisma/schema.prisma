generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Listing {
  id        String   @id @default(cuid())
  type      String   // "user" or "repo"
  github    String   // username or owner/repo
  name      String
  avatar    String
  stars     Int      @default(0)
  forks     Int      @default(0)
  followers Int      @default(0)
  repos     Int      @default(0)
  language  String?
  bio       String?
  url       String
  boost     Int      @default(0) // amount paid in cents
  clicks    Int      @default(0)
  active    Boolean  @default(false)
  checkoutId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteStats {
  id         String @id @default("global")
  totalViews Int    @default(0)
}
