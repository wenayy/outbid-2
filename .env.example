# Neon runtime connection. Use the pooled URL containing "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Optional for Prisma CLI migrations. Use Neon's direct, non-pooler URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Optional, but recommended to raise GitHub API rate limits.
GITHUB_TOKEN=""

# Required in production for paid listings.
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_SERVER="production"

# Required in production. Do not include a trailing slash.
NEXT_PUBLIC_APP_URL="https://your-domain.example"
